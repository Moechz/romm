# ===========================================================================
# Multilingual file for the TOS 7 Docker application "rommdocker".
# File name MUST be: <appid>.lang.  23-language superset (14 required by TOS).
# The App Center picks the text matching the user's device language;
# untranslated nodes fall back to English, which the official guide allows.
# Fields: name (app title), auth (upstream author), descript (up to 512
# chars), release_note, important (up to 512 chars).
# Translations come from tosapp.json "translations"; run
#   tosdocker lang <app>          to re-render this file
#   tosdocker translate <app>     to see what still needs translating
# ===========================================================================
[en-us]
name         = "RomM"
auth         = "rommapp"
version      = "@@VERSION@@"
descript     = "RomM is a self-hosted ROM manager: it scans your game library, fetches metadata and covers, and lets you browse and play in the browser. This package runs the official Docker Hub image with its own MariaDB database as non-root containers; the library and database stay in the application data folder."
release_note = "1. First release."
important    = "Put your ROM files into /Volume1/DockerAppData/rommdocker/library and scan them from the web UI. The stack contains two containers (app, MariaDB); the database password and RomM auth secret are generated on first start. Data lives under DockerAppData/rommdocker/ and survives restarts and updates. Needs DockerEngine; configure a registry mirror if Docker Hub is unreachable. Back up the data folder before uninstalling with data removal. Plain HTTP on the LAN."

[zh-cn]
name         = "RomM"
auth         = "rommapp"
version      = "@@VERSION@@"
descript     = "习惯打卡与连续天数统计，界面简洁。"
release_note = "1. First release."
important    = "首次使用请打开网页完成初始化。数据保存在 DockerAppData/beaverhabitsdocker，重启和升级不会丢失。容器以 uid 1000 运行，挂载目录需对该用户可读。需要 DockerEngine；Docker Hub 不可达时先配置镜像加速。卸载并删除数据前请备份。局域网内为 HTTP。"

