# ===========================================================================
# Multilingual file for the TOS 7 Docker application "rommdocker".
# File name MUST be: <appid>.lang.  23-language superset (14 required by TOS).
# The App Center picks the text matching the user's device language;
# untranslated nodes fall back to English, which the official guide allows.
# Fields: name (app title), auth (upstream author), descript (up to 512
# chars), release_note, important (up to 512 chars).
# Translations come from tosapp.json "translations"; run
#   tosdocker lang <app>          to re-render this file
#   tosdocker translate <app>     to see what still needs translating
# ===========================================================================
[en-us]
name         = "RomM"
auth         = "rommapp"
version      = "@@VERSION@@"
descript     = "RomM is a self-hosted ROM manager and browser emulator front end: scan a ROM library, match titles, covers and screenshots from metadata providers you configure (IGDB, ScreenScraper, MobyGames, SteamGridDB, RetroAchievements), sync saves and save states with your devices, and play supported systems in the browser with EmulatorJS. This package runs the official multi-arch Docker Hub image (amd64 + arm64) with its own MariaDB database; both containers run as an unprivileged user."
release_note = "Rectified per review comments (C10 C3 C4 C5 C6 C7 C8 C9 T1 S11): added a complete privacy policy (retention, user rights, security measures, third-party sharing, deletion channel), NOTICE and a full README; disclosed every third-party endpoint with the data sent and its region (IGDB, MobyGames, ScreenScraper, SteamGridDB, RetroAchievements, Hasheous, GitHub update check, Docker Hub, EmulatorJS CDN, UPC lookup, optional SMTP/OIDC); rewrote the 23-language descriptions so zh-cn/zh-hk no longer describe another application; removed leftover probe metadata copied from another application; hardened the entrypoint (waits for the database credential, 0600 secrets); upgraded upstream 4.8.1 -> 5.4.1 (CA and dependency security fixes)."
important    = "Put ROMs under /Volume1/DockerAppData/rommdocker/library and scan them from the web UI. Metadata providers and RetroAchievements need your own API keys, entered in Settings or config.yml; without keys RomM works offline from file names. Data stays in DockerAppData/rommdocker/ and survives updates. Needs DockerEngine; plain HTTP on the LAN, put a TLS reverse proxy in front before exposing it. Back up the folder before uninstalling with data removal."

[zh-cn]
name         = "RomM"
auth         = "rommapp"
version      = "@@VERSION@@"
descript     = "RomM 是自托管的 ROM 管理与模拟器前端：扫描游戏库后可从 IGDB、ScreenScraper、MobyGames、SteamGridDB、RetroAchievements 等元数据源匹配封面与资料（需自备 API 密钥），在浏览器里用 EmulatorJS 直接运行游戏，并可在多设备间同步存档与即时存档。本包使用官方多架构 Docker Hub 镜像（amd64 与 arm64），自带 MariaDB 数据库，两个容器均以非 root 用户运行。"
release_note = "按上轮审核意见整改（C10 C3 C4 C5 C6 C7 C8 C9 T1 S11）：补充完整隐私政策（保留期、用户权利、安全措施、第三方共享、删除渠道）、声明与完整 README；如实列出所有第三方端点及发送的数据与地区（IGDB、MobyGames、ScreenScraper、SteamGridDB、RetroAchievements、Hasheous、GitHub 更新检查、Docker Hub、EmulatorJS CDN、UPC 查询、可选 SMTP/OIDC）；重写 23 语言描述，zh-cn/zh-hk 不再描述其他应用；清除残留的其他应用 probe 元数据；强化 entrypoint（等待数据库凭据、密钥 0600）；上游由 4.8.1 升级到 5.4.1（证书与依赖安全修正）。"
important    = "把 ROM 放到 DockerAppData/rommdocker/library，然后在网页里扫描。元数据源与 RetroAchievements 需要你自备 API 密钥（在设置或 config.yml 中填写）；未配置密钥时仅按文件名整理，不联网。数据保存在 DockerAppData/rommdocker/，升级不丢失。需要 DockerEngine；局域网内为 HTTP，暴露到公网前请加 TLS 反向代理。卸载并删除数据前请备份。"

[zh-hk]
name         = "RomM"
auth         = "rommapp"
version      = "@@VERSION@@"
descript     = "RomM 是自託管的 ROM 管理與模擬器前端：掃描遊戲庫後可從 IGDB、ScreenScraper、MobyGames、SteamGridDB、RetroAchievements 等中繼資料來源比對封面與資料（需自備 API 金鑰），在瀏覽器內用 EmulatorJS 直接執行遊戲，並可在多裝置間同步存檔與即時存檔。本包使用官方多架構 Docker Hub 映像（amd64 與 arm64），內建 MariaDB 資料庫，兩個容器均以非 root 使用者執行。"
release_note = "按上輪審核意見整改（C10 C3 C4 C5 C6 C7 C8 C9 T1 S11）：補充完整隱私政策（保留期、使用者權利、安全措施、第三方分享、刪除管道）、聲明與完整 README；如實列出所有第三方端點及傳送的資料與地區（IGDB、MobyGames、ScreenScraper、SteamGridDB、RetroAchievements、Hasheous、GitHub 更新檢查、Docker Hub、EmulatorJS CDN、UPC 查詢、可選 SMTP/OIDC）；重寫 23 語言描述，zh-cn/zh-hk 不再描述其他應用；清除殘留的其他應用 probe 中繼資料；強化 entrypoint（等待資料庫憑證、密鑰 0600）；上游由 4.8.1 升級到 5.4.1（憑證與相依套件安全修正）。"
important    = "把 ROM 放到 DockerAppData/rommdocker/library，然後在網頁內掃描。中繼資料來源與 RetroAchievements 需要你自備 API 金鑰（在設定或 config.yml 中填寫）；未設定金鑰時僅依檔名整理，不連網。資料保存在 DockerAppData/rommdocker/，升級不遺失。需要 DockerEngine；區域網路內為 HTTP，對外開放前請加 TLS 反向代理。解除安裝並刪除資料前請備份。"

